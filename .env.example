# ============================================================================
# 1. CLOUD GEMINI API (Required for Track 2: Best Use of Gemma 4)
# ============================================================================
# The official google-genai SDK automatically picks up GEMINI_API_KEY
GEMINI_API_KEY="paste_your_google_ai_studio_api_key_here"

# Primary Gemma 4 model on Gemini API (MoE model = fastest live demo latency)
GEMMA_MODEL_ID="gemma-4-26b-a4b-it"

# Comma-separated fallback cascade if primary model hits rate limits
GEMMA_FALLBACK_MODELS="gemma-4-26b-a4b-it,gemma-4-31b-it,gemma-3-27b-it"


# ============================================================================
# 2. LOCAL OPEN-WEIGHT MODELS (Track 1: Ollama & LM Studio Support)
# ============================================================================
# Default local Ollama server host and chat endpoint
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_URL="http://127.0.0.1:11434/api/chat"

# Set this to the EXACT model tag shown when you run `ollama list` in terminal
# Common Gemma 4 tags: "gemma4:12b", "gemma4:26b-a4b-it-q4_K_M", or "gemma4:latest"
OLLAMA_MODEL="gemma4:12b"

# Keep the local model loaded in unified memory/VRAM for 30m during judging
OLLAMA_KEEP_ALIVE="30m"

# Local LM Studio OpenAI-compatible server endpoint and model identifier
LMSTUDIO_URL="http://127.0.0.1:1234/v1/chat/completions"
LMSTUDIO_MODEL="gemma-4-12b-it"


# ============================================================================
# 3. APP SERVER SETTINGS
# ============================================================================
PORT=8000
HOST="0.0.0.0"
